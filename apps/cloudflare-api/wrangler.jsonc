{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ordria-learning-api",
  "account_id": "74858fb12cfbc4a8a0ef2b33c2d6ff36",
  "main": "dist/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  // Keep-warm DURING BUSINESS HOURS ONLY — a ping every 2 minutes prevents
  // the 5-minute sleepAfter from firing (no 502 cold start for learners)
  // and doubles the DO retry rate during platform acquisition stalls
  // (cloudflare/containers#257). Outside the window the instance sleeps →
  // containers are billed per vCPU/GiB-SECOND awake, so nights are free;
  // the only cost is a ~55s cold start for a rare night visitor.
  // Window: 5-21 UTC = 7h-22h Paris summer AND 6h-23h Paris winter (the
  // union of both DST offsets — slightly over-covered on purpose).
  "triggers": {
    "crons": ["*/2 5-21 * * *"],
  },
  "containers": [
    {
      "class_name": "LearnHouseApiContainer",
      // Built & pushed to the Cloudflare registry automatically on deploy.
      "image": "./Dockerfile",
      "image_build_context": "../..",
      // Instance size: standard-1 (4 GiB RAM) since 2026-10-02 — basic's
      // 1 GiB was an OOM risk when ffmpeg video-transcoding spikes while a
      // class is live (whole academy = one container). Paid for by pairing
      // with the business-hours keep-warm below (asleep = unbilled).
      "instance_type": "standard-1",
      // Physical-instance cap. The LOGICAL singleton is already guaranteed by
      // the DO named-instance pattern (getContainer → one DO id → one live
      // container). Keeping this at 1 deadlocks rollouts: while a replaced
      // instance lingers in the scheduler's count (2026-10-01 outage: dead
      // instance counted against the cap → "reached max concurrent instances"
      // → no replacement could ever start → 503 for 2h). 3 gives replacement
      // windows headroom; the DO still runs exactly one container.
      "max_instances": 3
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "API_CONTAINER",
        "class_name": "LearnHouseApiContainer"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LearnHouseApiContainer"]
    }
  ],
  // Secrets (one-time setup):
  //   wrangler secret put LEARNHOUSE_SQL_CONNECTION_STRING   # Neon Postgres URL
  //   wrangler secret put LEARNHOUSE_AUTH_JWT_SECRET_KEY
  //   wrangler secret put NEXTAUTH_SECRET
  //   wrangler secret put COLLAB_INTERNAL_KEY
  //   wrangler secret put LEARNHOUSE_AI_API_KEY
  //   wrangler secret put AWS_ENDPOINT_URL_S3                 # https://<account>.r2.cloudflarestorage.com
  //   wrangler secret put AWS_ACCESS_KEY_ID                   # R2 token
  //   wrangler secret put AWS_SECRET_ACCESS_KEY
  //   wrangler secret put LEARNHOUSE_INITIAL_ADMIN_EMAIL
  //   wrangler secret put LEARNHOUSE_INITIAL_ADMIN_PASSWORD
  //
  // Zone routes — MORE SPECIFIC than the frontend's learn.ordria.fr/* catch-all,
  // so they take precedence (same-origin: no CORS needed):
  "routes": [
    { "pattern": "learn.ordria.fr/api/v1*", "zone_name": "ordria.fr" },
    { "pattern": "learn.ordria.fr/content*", "zone_name": "ordria.fr" },
    { "pattern": "learn.ordria.fr/collab*", "zone_name": "ordria.fr" }
  ]
}
