#syntax=docker/dockerfile:1
# ─────────────────────────────────────────────────────────────────────────────
# Render.com image — OrdIA Learning ALL-IN-ONE
# Frontend (Next.js standalone) + FastAPI API + collab + redis + nginx
# in ONE service, single URL, same-origin — same layout as the classic
# LearnHouse docker image. Build context: REPOSITORY ROOT.
#
#   nginx :${PORT:-8080} — single exposed port, routes to:
#     /ping           → 200 (readiness check)
#     /collab         → Hocuspocus :4000 (WebSocket)
#     /api/v1, /content → FastAPI :9000
#     everything else → Next.js frontend :3000 (incl. /api/auth NextAuth)
# ─────────────────────────────────────────────────────────────────────────────

# ───────────────────────────────────────────────
# Stage 1: Frontend dependencies
# ───────────────────────────────────────────────
FROM oven/bun:1-alpine AS frontend-deps
RUN apk update && apk add --no-cache libc6-compat && rm -rf /var/cache/apk/*
WORKDIR /app
COPY apps/web/package.json apps/web/bun.lock* ./
RUN bun install --frozen-lockfile

# ───────────────────────────────────────────────
# Stage 2: Frontend build (standalone output)
# ───────────────────────────────────────────────
FROM oven/bun:1-alpine AS frontend-builder
WORKDIR /app
COPY --from=frontend-deps /app/node_modules ./node_modules
COPY apps/web .

# Skip TS/ESLint checks in Docker build — RAM-heavy, validated in dev/CI
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_IGNORE_TYPECHECK=1 \
    NEXT_IGNORE_LINT=1 \
    BUILD_FOR_PAGES=1

# Baked defaults — overridden at runtime by server-wrapper.js (runtime-config)
ARG PUBLIC_BASE_URL=https://ordia-api-9xnv.onrender.com
ENV NEXT_PUBLIC_LEARNHOUSE_BACKEND_URL=${PUBLIC_BASE_URL} \
    NEXT_PUBLIC_LEARNHOUSE_API_URL=${PUBLIC_BASE_URL}/api/v1/ \
    NEXT_PUBLIC_COLLAB_URL=wss://ordria-api-9xnv.onrender.com/collab \
    NEXT_PUBLIC_LEARNHOUSE_HTTPS=True \
    NEXT_PUBLIC_LEARNHOUSE_MULTI_ORG=False \
    NEXT_PUBLIC_LEARNHOUSE_DEFAULT_ORG=default \
    NEXT_PUBLIC_LEARNHOUSE_OSS=true

RUN rm -f .env*
RUN bun run build

# ───────────────────────────────────────────────
# Stage 3: Collab server build
# ───────────────────────────────────────────────
FROM oven/bun:1-alpine AS collab-builder
WORKDIR /app
COPY apps/collab/package.json apps/collab/bun.lock* ./
RUN bun install --frozen-lockfile
COPY apps/collab/tsconfig.json ./
COPY apps/collab/src/ ./src/
RUN bun run build

# ───────────────────────────────────────────────
# Stage 4: Runtime image (frontend + api + collab + redis + nginx)
# ───────────────────────────────────────────────
FROM python:3.14-slim-bookworm AS runner

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        nginx curl netcat-openbsd ca-certificates redis-server ffmpeg gnupg unzip \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get purge -y gnupg \
    && apt-get autoremove -y \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /tmp/* /root/.npm

# ── Frontend: Next.js standalone (server-wrapper injects runtime env) ──
COPY --from=frontend-builder /app/.next/standalone /app/web
COPY --from=frontend-builder /app/.next/static /app/web/.next/static
COPY --from=frontend-builder /app/public /app/web/public
COPY apps/web/server-wrapper.js /app/web/server-wrapper.js

# ── Backend: Python deps (cached layer, then source) ──
WORKDIR /app/api
COPY apps/api/uv.lock apps/api/pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip uv \
    && uv sync --no-dev
COPY apps/api ./

# ── Collab: compiled JS + production deps ──
WORKDIR /app/collab
COPY --from=collab-builder /app/dist ./dist
COPY apps/collab/package.json apps/collab/bun.lock* ./
# bun via the official installer (static glibc build); the alpine builder's
# binary is musl-linked and won't run on bookworm.
RUN curl -fsSL https://bun.sh/install | bash \
    && mv /root/.bun/bin/bun /usr/local/bin/bun && rm -rf /root/.bun \
    && bun install --production

# ── Configs ──
COPY apps/cloudflare-api/nginx-api.conf /etc/nginx/nginx-api.conf
COPY apps/cloudflare-api/start-api.sh /app/start-api.sh
RUN chmod +x /app/start-api.sh

# ── Non-root user + world-readable/executable app tree ──
# Some runtimes (Render) execute the image as an arbitrary UID that doesn't
# match appuser — a+rX guarantees traversal + exec on the venv binaries for
# ANY runtime user.
RUN useradd --create-home --uid 1001 appuser \
    && mkdir -p /tmp/nginx /tmp/api-logs \
    && chown -R appuser:appuser /app /tmp/nginx /tmp/api-logs \
    && chmod -R a+rX /app /home/appuser \
    && chmod 755 /home/appuser
USER appuser
ENV HOME=/home/appuser

ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    LEARNHOUSE_PORT=9000 \
    COLLAB_PORT=4000 \
    HOSTNAME=127.0.0.1 \
    LEARNHOUSE_OSS=true \
    LEARNHOUSE_REDIS_CONNECTION_STRING=redis://127.0.0.1:6379/0 \
    LEARNHOUSE_REDIS_URL=redis://127.0.0.1:6379

EXPOSE 8080

CMD ["/app/start-api.sh"]
